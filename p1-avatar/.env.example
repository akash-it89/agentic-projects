# Copy to .env and edit. Never commit .env.

# auto | cuda | cpu   (auto picks cuda when PyTorch can see a GPU)
DEVICE=auto

# --- Retrieval ---
QDRANT_URL=http://localhost:6333
COLLECTION=airport
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_K=20
TOP_PASSAGES=4
# Reranker score (0..1) below which a passage is ignored. Calibrate with eval/run_eval.py.
MIN_SCORE=0.35

# --- Answer LLM: ollama | bedrock ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Bedrock: many models need the cross-region inference profile ID (us. prefix). Check the console.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# Credentials come from `aws configure` (~/.aws), not from this file.

# --- Speech to text: local (faster-whisper in-process) | speaches (Docker service) ---
ASR_BACKEND=local
WHISPER_MODEL=large-v3
SPEACHES_BASE_URL=http://localhost:8000/v1
SPEACHES_MODEL=Systran/faster-whisper-large-v3

# --- Text to speech (Kokoro-FastAPI) ---
KOKORO_BASE_URL=http://localhost:8880/v1

# --- Avatar (ditto_service running in WSL2 / Linux GPU box) ---
AVATAR_ENABLED=true
DITTO_URL=http://localhost:8090

# --- Real-time agent: cascaded | nova ---
AGENT_MODE=cascaded
# Defaults for `livekit-server --dev`. Use your LiveKit Cloud values instead if you use Cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
