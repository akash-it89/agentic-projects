# Copy to .env and edit. Every value has a working default.

# --- OCR for scans and photos: paddle (local, free) | textract (AWS; Latin-script languages only) ---
# Born-digital PDFs skip OCR entirely: their own text layer is exact and free.
OCR_ENGINE=paddle
OCR_DEVICE=cpu
# PP-OCRv5_mobile_det is much faster on CPU than PP-OCRv5_server_det (see project 2's README for numbers)
DET_MODEL=PP-OCRv5_mobile_det
# PaddlePaddle's oneDNN CPU acceleration. Leave commented: it's off on Windows (where a PaddlePaddle bug
# raises "NotImplementedError") and on elsewhere. If OCR fails with NotImplementedError anywhere, set false.
# OCR_MKLDNN=false
RENDER_DPI=200

# --- Re-read low-confidence OCR lines with a local vision model: none | vlm ---
CORRECTION=none
VLM_MODEL=qwen2.5vl:7b
KEEP_SCORE=0.85

# --- LLM for extraction, classification, summary and chat: ollama | bedrock ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# A smaller, cheaper model just for classification (the trainer's advice). Empty = use OLLAMA_MODEL.
CLASSIFY_MODEL=qwen2.5:3b
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# --- Chat retrieval: bm25 (no model needed) | ollama (embeddings; run `ollama pull bge-m3` first) ---
RETRIEVER=bm25
EMBED_MODEL=bge-m3
