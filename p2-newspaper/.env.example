# Copy to .env and edit. Every value here has a working default; change only what you're tuning.

# en | ta | ar  (PaddleOCR recognition model; ar also switches reading order to right-to-left)
OCR_LANG=en
# cpu | gpu   (gpu only with an NVIDIA card and paddlepaddle-gpu)
OCR_DEVICE=cpu

# --- Text detection (PaddleOCR) ---
# PP-OCRv5_mobile_det is much faster on CPU. PP-OCRv5_server_det may be more accurate: compare on your pages.
DET_MODEL=PP-OCRv5_mobile_det
# PaddlePaddle's oneDNN CPU acceleration. Leave commented: it's off on Windows (where a PaddlePaddle bug
# raises "NotImplementedError") and on elsewhere. If OCR fails with NotImplementedError anywhere, set false.
# OCR_MKLDNN=false
# Big newspaper scans get shrunk before detection by default, which loses small type. Keep this high.
DET_LIMIT_SIDE_LEN=4000
# How much each detected text box is padded. Larger = boxes touch and merge more easily.
DET_UNCLIP_RATIO=1.5
DET_BOX_THRESH=0.6

# --- Lines -> blocks ---
# Merge a line into the block above when the vertical gap is at most MERGE_GAP_K x median line height
MERGE_GAP_K=0.8
# ...and the two overlap horizontally by at least this share of the narrower one
MERGE_OVERLAP_MIN=0.5
# A block whose line height is this many times the page median is treated as a headline
HEADLINE_RATIO=1.3
# Blocks whose left edges differ by more than this share of page width are in different columns
COLUMN_GAP_RATIO=0.05

# --- Article decider: rules | cascade (rules, then a small local LLM for unclear pairs) ---
DECIDER=cascade
OLLAMA_HOST=http://localhost:11434
DECIDER_MODEL=qwen2.5:3b

# --- Text correction: none | vlm (re-read low-confidence blocks with a local vision model) ---
CORRECTION=none
VLM_MODEL=qwen2.5vl:7b
# Blocks with a mean OCR score at or above this keep PaddleOCR's text
KEEP_SCORE=0.9
